# Secrets: only .env.example is committed
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
credentials.json
service-account*.json

# Veteran data must never enter the repo
data/
uploads/
exports/
*.dump
*.sql.gz
*.sqlite
*.db

# Infrastructure state can hold secrets
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!example.tfvars

# Dependencies and build output
node_modules/
dist/
build/
.next/
coverage/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Logs can contain PII
*.log
logs/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
