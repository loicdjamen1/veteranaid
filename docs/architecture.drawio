<mxfile host="app.diagrams.net"><diagram name="VeteranAid architecture" id="vaarch"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="VeteranAid platform architecture and trust boundaries (plan phase)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="z1" value="TB1 Internet: untrusted users and partners" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFAFA;dashed=1;strokeColor=#B85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1700" height="120" as="geometry"/></mxCell>
<mxCell id="veteran" value="Veteran&lt;br&gt;(phone or shared computer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="50" y="80" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="caseworker" value="Caseworker&lt;br&gt;(one state only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="80" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="manager" value="State programme manager&lt;br&gt;(MD or VA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="530" y="80" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="staffadmin" value="VeteranAid staff admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="770" y="80" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="partner" value="Referral partner system&lt;br&gt;(housing nonprofit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1250" y="80" width="210" height="60" as="geometry"/></mxCell>
<mxCell id="z2" value="TB2 Edge: the only public entry points (TLS only)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF8F0;dashed=1;strokeColor=#B85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="1700" height="110" as="geometry"/></mxCell>
<mxCell id="waf" value="&lt;b&gt;WAF / CDN&lt;/b&gt;&lt;br&gt;TLS, bot and rate limiting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="290" y="220" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="idp" value="&lt;b&gt;Identity provider&lt;/b&gt; (Microsoft Entra ID)&lt;br&gt;MFA for staff, state claim in every token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="680" y="220" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="gateway" value="&lt;b&gt;API gateway&lt;/b&gt;&lt;br&gt;partner keys, OAuth, quotas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1180" y="220" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="z3" value="TB3 Approved cloud (Azure): VeteranAid private network (application tier)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F9FF;dashed=1;strokeColor=#B85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="1390" height="280" as="geometry"/></mxCell>
<mxCell id="website" value="&lt;b&gt;Public website&lt;/b&gt;&lt;br&gt;veteran login, self-service, chat widget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="380" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="portal" value="&lt;b&gt;Admin portal&lt;/b&gt;&lt;br&gt;eligibility, cases, grant reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="380" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="publicapi" value="&lt;b&gt;Public partner API&lt;/b&gt;&lt;br&gt;submit referrals, see own referral status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1130" y="380" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="audit" value="&lt;b&gt;Audit log&lt;/b&gt;&lt;br&gt;append-only, every record access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="50" y="510" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="coreapi" value="&lt;b&gt;Core API (internal)&lt;/b&gt;&lt;br&gt;the only path to data; state scope from token enforced on every call, deny by default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="510" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="chatbot" value="&lt;b&gt;Chatbot service&lt;/b&gt;&lt;br&gt;guardrails, no eligibility or legal advice, hands off to a caseworker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="830" y="510" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="z5" value="TB5 AI platform: Azure AI Foundry" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF5F5;dashed=1;strokeColor=#B85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1440" y="330" width="280" height="280" as="geometry"/></mxCell>
<mxCell id="model" value="&lt;b&gt;Model endpoint&lt;/b&gt;&lt;br&gt;private link, no training on our data, no retention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1470" y="390" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="safety" value="&lt;b&gt;Content filters&lt;/b&gt;&lt;br&gt;prompt-injection and PII checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1470" y="510" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="z4" value="TB4 Data tier: one partition per state, encrypted with separate keys" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7FBF5;dashed=1;strokeColor=#B85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="1700" height="200" as="geometry"/></mxCell>
<mxCell id="mdzone" value="Maryland programme (own grant, own key)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="820" height="140" as="geometry"/></mxCell>
<mxCell id="vazone" value="Virginia programme (own grant, own key)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="680" width="820" height="140" as="geometry"/></mxCell>
<mxCell id="mddb" value="&lt;b&gt;Maryland database&lt;/b&gt;&lt;br&gt;profiles, eligibility, cases, claims, grant reports" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="712" width="320" height="96" as="geometry"/></mxCell>
<mxCell id="mdfiles" value="&lt;b&gt;Maryland file store&lt;/b&gt;&lt;br&gt;DD-214s, medical letters, leases, notes, chat transcripts" style="shape=folder;whiteSpace=wrap;html=1;tabWidth=50;tabHeight=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="718" width="350" height="84" as="geometry"/></mxCell>
<mxCell id="vadb" value="&lt;b&gt;Virginia database&lt;/b&gt;&lt;br&gt;profiles, eligibility, cases, claims, grant reports" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="920" y="712" width="320" height="96" as="geometry"/></mxCell>
<mxCell id="vafiles" value="&lt;b&gt;Virginia file store&lt;/b&gt;&lt;br&gt;DD-214s, medical letters, leases, notes, chat transcripts" style="shape=folder;whiteSpace=wrap;html=1;tabWidth=50;tabHeight=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1310" y="718" width="350" height="84" as="geometry"/></mxCell>
<mxCell id="legend" value="Red dashed boxes are trust boundaries (TB1 to TB5); the thick red boxes are the Maryland/Virginia boundary that must never be crossed. Users and partners reach only the edge. Only the Core API touches the databases and file stores, and it filters every request by the state in the user's token. The chatbot and partners never reach data directly, and the AI platform never receives names, SSNs or documents." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="855" width="1700" height="50" as="geometry"/></mxCell>
