# Copy to .env and fill in locally. Never commit .env.
# Deployed environments read these from the cloud secret store, not from files.
# Leave values empty here: real or realistic values do not belong in this file.

APP_ENV=local

# Cloud platform: azure or aws (to confirm)
CLOUD_PROVIDER=

# Identity provider (Entra ID or Cognito)
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Database: one per state, never shared
DATABASE_URL_MD=
DATABASE_URL_VA=

# File store: one per state, each with its own encryption key
FILE_STORE_MD=
FILE_STORE_VA=
ENCRYPTION_KEY_ID_MD=
ENCRYPTION_KEY_ID_VA=

# Chatbot model (Azure AI Foundry or AWS Bedrock, to confirm)
AI_ENDPOINT=
AI_MODEL_ID=
AI_API_KEY=

# Public partner API
PARTNER_API_SIGNING_SECRET=
