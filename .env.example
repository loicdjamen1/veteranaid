# Copy to .env and fill in locally. Never commit .env.
# Leave values empty here: real or realistic values do not belong in this file.

APP_ENV=local

# Postgres (Docker Compose). Each organisation has its own database and user.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=
IDENTITY_DB_USER=
IDENTITY_DB_PASSWORD=
ORG_MARYLAND_DB_USER=
ORG_MARYLAND_DB_PASSWORD=
ORG_VIRGINIA_DB_USER=
ORG_VIRGINIA_DB_PASSWORD=

# Sessions: long random value, different in every environment
SESSION_SECRET=

# Uploads: one folder per organisation inside the uploads volume
UPLOAD_ROOT=/data/uploads
UPLOAD_MAX_MB=10
CLAMAV_HOST=clamav

# Chatbot: Azure AI Foundry in our own subscription (spending limit on)
AZURE_AI_ENDPOINT=
AZURE_AI_DEPLOYMENT=
AZURE_AI_API_KEY=
CHAT_MAX_MESSAGES_PER_USER_PER_DAY=50

# Public partner API
PARTNER_API_KEY_PEPPER=

# Security event log (JSON lines)
SECURITY_LOG_PATH=logs/security.jsonl
